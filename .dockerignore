
# Spectra's editor is a project of its own, installed in the build stage from
# its own lockfile.
spectra-editor/node_modules

# Spectra's renderer is fetched and patched in the build (scripts/prepare-spectra-editor.mjs), and so is its cache.
spectra-editor/src/renderer
spectra-editor/.prepared
.cache

# OpenCut's editor, the same way: its own lockfile in the build stage, its source fetched and overlaid there.
opencut-editor/node_modules
opencut-editor/src/web
opencut-editor/src/web-public
opencut-editor/.prepared
