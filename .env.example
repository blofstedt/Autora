# --- Gemini ---------------------------------------------------------------
# Required for real replies. Without it the console still runs, but the agent
# answers with local fallbacks and says so.
#
# Get one at https://aistudio.google.com/apikey (Google AI Studio -> Get API
# key). The free tier covers Flash; a key whose credits run out returns a
# billing error, which the app shows in the thread rather than hiding.
GEMINI_API_KEY=

# Which model to call. Defaults to gemini-flash-latest, the rolling alias for
# Google's current free Flash -- so the app keeps working when a dated model
# retires. Pin a specific one here if you need a fixed version.
# GEMINI_MODEL=gemini-flash-latest

# Thinking budget, in tokens. Default 0: a console is watched, and thinking
# spends seconds and tokens before the first word appears. Raise it for harder
# questions, or set -1 to let the model decide.
# GEMINI_THINKING_BUDGET=0

# --- Other providers ------------------------------------------------------
# All optional, and all of these can also be pasted into Settings instead --
# which saves them on the server in .autora/settings.json and survives a
# restart. A key set here is used when the app has none of its own; the panel
# shows which of the two is in force.
#
# OpenAI          https://platform.openai.com/api-keys
# OPENAI_API_KEY=
#
# Anthropic       https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=
#
# DeepSeek        https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=
#
# OpenRouter -- one key, hundreds of models, prices fetched live
#                 https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# --- State ----------------------------------------------------------------
# Where the chosen provider, the keys saved from Settings, and the spend
# ledger behind the billing card are written. Defaults to .autora/ beside the
# app; the directory is created 0700 and the file 0600.
# AUTORA_STATE_DIR=.autora
