# .env.example
# Every key is optional: keys can also be pasted into Settings, which wins.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ORCA_ROUTER_API_KEY=
LOCAL_API_KEY=

# Where to listen. The default is this machine only (127.0.0.1); 0.0.0.0
# makes it reachable from the network, which has no login of its own.
# AUTORA_HOST=0.0.0.0
# AUTORA_PORT=3000

# Also serve https on AUTORA_PORT + 1, for the microphone on a phone.
# AUTORA_TLS=1
